# Địa chỉ FastAPI backend (không thêm /docs)
BACKEND_URL=http://127.0.0.1:8000
# Đặt 1 để dùng cả dữ liệu địa điểm và bản dịch giả lập (không cần backend)
MOCK_API=0
# Đặt 1 chỉ khi muốn bỏ qua VNPay và dùng trang thanh toán mô phỏng local
MOCK_PAYMENT=0
# Cổng chạy visitor-web (khác 5173 của admin-web)
PORT=5174
# Chỉ cần khi MOCK_PAYMENT=0: thông tin sandbox trong trang merchant VNPay
VNPAY_TMN_CODE=YOUR_TMN_CODE_HERE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET_HERE
# URL HTTPS public (ví dụ URL ngrok) và phải khớp URL đã đăng ký trên VNPay
VNPAY_RETURN_URL=https://your-public-host.example/pay/return
