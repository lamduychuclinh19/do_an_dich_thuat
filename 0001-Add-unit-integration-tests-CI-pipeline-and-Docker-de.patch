+FROM node:22-alpine AS build
+WORKDIR /app
+COPY package.json package-lock.json ./
+RUN npm ci
+COPY . .
+# "/" = gọi API cùng origin (nginx chuyển tiếp /api và /audio sang backend)
+ARG VITE_API_URL=/
+ENV VITE_API_URL=$VITE_API_URL
+RUN npm run build
+
+FROM nginx:stable-alpine
+COPY nginx.conf /etc/nginx/conf.d/default.conf
+COPY --from=build /app/dist /usr/share/nginx/html
+EXPOSE 80
diff --git a/admin-web/nginx.conf b/admin-web/nginx.conf
new file mode 100644
index 0000000..4e05f3b
--- /dev/null
+++ b/admin-web/nginx.conf
@@ -0,0 +1,31 @@
+server {
+    listen 80;
+    server_name _;
+
+    root /usr/share/nginx/html;
+    index index.html;
+
+    # DNS nội bộ của Docker: nginx tự phân giải lại IP của "api"
+    # mỗi khi container api được tạo lại (tránh lỗi 502 sau khi deploy).
+    resolver 127.0.0.11 valid=10s;
+    set $backend http://api:8000;
+
+    client_max_body_size 2m;   # file TXT tối đa 1 MB
+
+    location /api/ {
+        proxy_pass $backend;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+    }
+
+    location /audio/ {
+        proxy_pass $backend;
+    }
+
+    # React Router: mọi đường dẫn còn lại trả về index.html
+    location / {
+        try_files $uri /index.html;
+    }
+}
