# SMTP_HOST: Gmail's outgoing mail server. Keep this value for Gmail.
SMTP_HOST=smtp.gmail.com
# SMTP_PORT: keep 587 for STARTTLS.
SMTP_PORT=587
# SMTP_STARTTLS: encrypt the connection before signing in.
SMTP_STARTTLS=true
# SMTP_USERNAME: the Gmail address that will send the notification.
SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD: the 16-character Google App Password (not your Gmail password).
SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM: sender shown to the recipient; normally the same Gmail address.
SMTP_FROM=your-account@gmail.com

# Ollama local API and translation model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=qwen3:1.7b
